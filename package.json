{
  "name": "mig-dms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @mig/web",
    "build": "npm run build -w @mig/web && node scripts/copy-web-dist.mjs",
    "preview": "npm run preview -w @mig/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e -w @mig/web",
    "api:dev": "npm run dev -w @mig/api",
    "api:build": "npm run build -w @mig/api",
    "api:test": "vitest run --project api",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e && npm audit --audit-level=high",
    "build:openapi": "node scripts/build-openapi.mjs",
    "db:gen": "node scripts/gen-schema.mjs && node scripts/gen-seed-sql.mjs && node scripts/gen-rls-tests.mjs",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "i18n:export": "node scripts/i18n-export-review.mjs",
    "i18n:import": "node scripts/i18n-import-review.mjs"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
