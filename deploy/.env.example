# deploy/.env — the environment of deploy/docker-compose.yml. Copy to `.env` (never committed: .gitignore),
# fill in, `chmod 600 .env`. Secrets: `sh scripts/gen-secrets.sh --fill .env` generates every empty secret below.
# Every variable is described in deploy/README.md; rotation of each secret — «Ротация секретов».

# ---------------------------------------------------------------- environment and site
# production | staging (staging: demo data, «Войти как…» and the demo routes of the API; production: none of it)
APP_ENV=
# Site name (DNS A/AAAA record → this server), e.g. dms.mig.uz or staging.dms.mig.uz
DOMAIN=
# TLS: an e-mail for automatic certificates (Let's Encrypt/ZeroSSL, needs ports 80/443 from the Internet), or the
# paths of certificates provided by MIG inside the container: /certs/fullchain.pem /certs/privkey.pem
CADDY_TLS=
# Directory on the server with the provided certificates (mounted read-only to /certs)
TLS_CERTS_DIR=
# Published ports (only Caddy publishes any). Defaults: all addresses, 80 and 443.
PUBLISH_ADDR=
HTTP_PORT=
HTTPS_PORT=
# Images: built locally by `docker compose build` by default; CI may push and set them (deploy/README.md)
API_IMAGE=
CADDY_IMAGE=

# ---------------------------------------------------------------- Supabase (self-hosted)
POSTGRES_PASSWORD=
# At least 32 characters; signs the access tokens of Supabase Auth and ANON_KEY / SERVICE_ROLE_KEY
JWT_SECRET=
# JWTs signed with JWT_SECRET (role anon / service_role); scripts/gen-secrets.sh makes them
ANON_KEY=
SERVICE_ROLE_KEY=
# Studio basic auth (profile `studio`, through an SSH tunnel only)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
STUDIO_LOCAL_PORT=

# ---------------------------------------------------------------- API secrets
# AES-256-GCM keys of personal data by version: 1:<base64 of 32 bytes>[,2:<…>]. Required in production.
# KEEP A COPY OUTSIDE THE SERVER: without these keys a backup cannot be read.
PII_KEYS=
# Version for new values (default: the highest)
PII_KEY_CURRENT=
# HMAC key of the search hashes of PINFL and phone (at least 32 bytes). Required in production.
PII_HMAC_KEY=
# HMAC key of the session ids (at least 32 characters). Required in production.
SESSION_SECRET=
# Secret of the «Send SMS» hook, the same for Supabase Auth and the API: v1,whsec_<base64>
SMS_HOOK_SECRET=
# SMS adapter of the API: `log` at stage 1 (the provider of MIG plugs in at stage 2)
SMS_PROVIDER=
# STAGING ONLY: password of new e-mail accounts instead of an invitation (must stay empty in production)
DEMO_PASSWORD=
LOG_LEVEL=
DB_POOL_SIZE=
# Number of API containers (production 4 on 8 vCPU, staging 1; docs/backend/LOAD.md)
API_REPLICAS=

# ---------------------------------------------------------------- SMTP of MIG (invitations from Supabase Auth)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=

# ---------------------------------------------------------------- Supabase Auth rate limits (per client IP)
AUTH_RATE_LIMIT_EMAIL_SENT=
AUTH_RATE_LIMIT_SMS_SENT=
AUTH_RATE_LIMIT_VERIFY=
AUTH_RATE_LIMIT_TOKEN_REFRESH=
AUTH_RATE_LIMIT_OTP=
AUTH_RATE_LIMIT_MFA=

# ---------------------------------------------------------------- backups (deploy/backup/)
# Local directory of the backups on the server (daily/, monthly/)
BACKUP_DIR=
BACKUP_KEEP_DAILY=
BACKUP_KEEP_MONTHLY=
# Separate S3-compatible storage for the copies (rclone, service `offsite`)
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Alternative to S3: rsync over SSH to a backup host (user@host:/path; the SSH key of root on this server)
BACKUP_RSYNC_TARGET=
