// Cloudflare Workers static-assets deployment (Workers Builds runs `npx wrangler deploy`).
// The web app lives in apps/web (npm workspaces); `npm run build` copies its build to ./dist.
// Security headers come from apps/web/public/_headers; VITE_* variables are set in the Cloudflare dashboard.
{
  "name": "new-erp-mig",
  "compatibility_date": "2025-09-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
